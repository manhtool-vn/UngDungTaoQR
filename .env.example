# ===== Máy chủ =====
# development | production (production bắt buộc PUBLIC_URL https và JWT_SECRET >= 32 ký tự)
NODE_ENV=development
PORT=5180
# Địa chỉ công khai của trang (không có / ở cuối). Dùng để tạo Redirect URI, kiểm tra Origin và bật cookie Secure khi là https.
PUBLIC_URL=http://localhost:5180
# Địa chỉ in vào mã QR động: SHORT_URL/q/<tên>. Nên là tên miền NGẮN (mã thưa chấm, dễ quét)
# và KHÔNG ĐƯỢC ĐỔI sau khi khách đã in mã. Tên miền này phải trỏ về cùng máy chủ. Để trống = PUBLIC_URL.
SHORT_URL=
# Thư mục lưu dữ liệu (data/db.json) — nhớ sao lưu thường xuyên
DATA_DIR=data
# Đặt true khi chạy sau Nginx / Cloudflare để lấy đúng IP người dùng (và quốc gia từ header CF-IPCountry)
TRUST_PROXY=false

# ===== Đăng nhập (JWT) =====
# Khóa ký JWT: chuỗi ngẫu nhiên >= 32 ký tự. Tạo bằng lệnh:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Đổi khóa = mọi người phải đăng nhập lại.
JWT_SECRET=
# Access token sống bao nhiêu phút (mặc định 15)
ACCESS_TOKEN_MINUTES=15
# Giữ đăng nhập bao nhiêu ngày (refresh token, mặc định 30)
SESSION_DAYS=30

# Email được cấp quyền quản trị (cách nhau bởi dấu phẩy).
# Ngoài ra, tài khoản đăng nhập đầu tiên của hệ thống tự động là quản trị viên.
ADMIN_EMAILS=

# ===== Thanh toán gói Pro (chuyển khoản VietQR, đối soát tự động qua webhook SePay) =====
# Khóa bí mật (>= 16 ký tự) để SePay gọi webhook PUBLIC_URL/api/payments/webhook.
# Trên SePay: Webhooks → Thêm webhook → URL trên, kiểu chứng thực "API Key", dán khóa này.
# Số tài khoản, ngân hàng, giá bán đặt trong Quản trị → Cài đặt → Thanh toán.
PAYMENT_WEBHOOK_KEY=

# ===== Đăng nhập bằng Google =====
# Khuyên dùng: nhập Client ID / Client secret tại Quản trị → Cài đặt.
# Hoặc đặt tại đây (sẽ ưu tiên hơn cài đặt trong trang quản trị):
# GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# GOOGLE_LOGIN_ENABLED=true
# Mặc định redirect URI = PUBLIC_URL + /api/auth/google/callback
# GOOGLE_REDIRECT_URI=
